# Optional deployment settings.
DATABASE_URL=sqlite+aiosqlite:///./fedcompass.db
REAL_DATA_ROOT=
CORS_ORIGINS=["http://localhost:5173"]

# Optional OpenAI-compatible provider for the experiment configuration assistant.
# Leave these blank to use the local deterministic parser.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# Background operations/security/result agents use the local Qwen service.
# The experiment scenario agent continues to use the LLM_* settings above or
# the request-level API/local switch in the configuration assistant.
AGENT_LLM_PROVIDER=local
AGENT_LLM_LOCAL_BASE_URL=http://127.0.0.1:8001/v1
AGENT_LLM_LOCAL_MODEL=Qwen/Qwen3-0.6B
AGENT_LLM_MAX_TOKENS=1600
AGENT_LLM_TIMEOUT_SECONDS=75
RUNTIME_AGENT_CHECK_INTERVAL_ROUNDS=3
